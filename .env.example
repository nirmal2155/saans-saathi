# SaansSaathi Environment Configuration Example
# Copy this file to .env for local development

# Optional: Google Gemini API Key for AI explanations in /api/summary
# If omitted or invalid, SaansSaathi gracefully falls back to the deterministic rule engine.
GEMINI_API_KEY=your_gemini_api_key_here

# Server Configuration (optional defaults)
PORT=8000
HOST=0.0.0.0
